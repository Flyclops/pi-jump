{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "node"
    ],
    "paths": {
      "@earendil-works/*": [
        "./.pi-host/*/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "extensions",
    "src",
    "test"
  ]
}
